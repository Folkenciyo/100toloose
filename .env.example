# ============================================================
# 100toLoose — Variables de entorno
# Copia este archivo a .env y rellena los valores reales
# NUNCA commitees el archivo .env
# ============================================================

# --- Base de datos PostgreSQL ---
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=100toloose-db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- JWT ---
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_64_char_hex_secret_key_here

# --- Encriptación BD ---
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here

# --- PgAdmin ---
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=your_pgadmin_password

# --- Binance (opcional — se configura también desde el perfil de usuario) ---
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TESTNET=true

# --- Frontend ---
VITE_API_URL=http://localhost
